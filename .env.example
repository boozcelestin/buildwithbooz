# Public application URL
NEXT_PUBLIC_SITE_URL=https://buildwithbooz.com

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Convex values generated by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Stripe server values. The Price must be active, one time, USD, and exactly $1,000.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Active one time USD Price for exactly $5,000
STRIPE_PRICE_ID_BLUEPRINT=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile values for public form protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend values belong in the Convex environment, not this file
# RESEND_API_KEY
# RESEND_FROM_EMAIL
